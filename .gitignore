*.sln.docstates

# IDE settings
.vscode/
.idea/
.vs/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Android
.nomedia
/android/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux / Unix
*~
.fuse_hidden*
.Trash-*
