[configuration]

entry_symbol = "win_click_through_library_init"
compatibility_minimum = "4.5"
# Not reloadable: ExtraWindow holds a Ref to an instance, so swapping the library
# underneath it during an editor hot-reload would leave that reference dangling.
reloadable = false

[libraries]

windows.debug.x86_64 = "res://WinClickThrough/windows/winclickthrough.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://WinClickThrough/windows/winclickthrough.windows.template_release.x86_64.dll"
